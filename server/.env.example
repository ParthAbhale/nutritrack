# ---------------------------------------------------------------------------
# NutriTrack API configuration. Copy to server/.env and fill in real values.
# Never commit .env. All values are validated at startup; the server prints
# which variables are missing or invalid (never their values).
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nutritrack?retryWrites=true&w=majority
# Local development: run `npm run db:dev -w server` and use the printed URI, e.g.
MONGODB_URI=MONGODB_URI=mongodb+srv://parth_nutritrack:GtFmA80yYNLzG4tg@cluster0.misfxhv.mongodb.net/nutritrack?retryWrites=true&w=majority

# Comma-separated list of allowed browser origins (CORS allowlist).
CLIENT_ORIGIN=http://localhost:5173
# Public URL of the web app, used in email links (defaults to the first CLIENT_ORIGIN).
APP_URL=http://localhost:5173

# Secrets: generate each with `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_ACCESS_SECRET=k9vP2xR5wL8mZ3yN7bQ1sF4jH6dC0vX9
CSRF_SECRET=k9vP2xR5wL8mZ3yN7bQ1sFkjasdfjkaskfhjasdfasdhf

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# lax when the web app and API share a site (recommended: proxy /api through the web host).
# none only when they are on different sites (requires HTTPS; cookies become Secure).
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=
# Number of reverse proxies in front of the API (Render/Railway/Fly: 1). Needed for correct client IPs in rate limiting.
TRUST_PROXY=0
AUTH_RATE_LIMIT=30
LOG_LEVEL=info

# --- Nutrition providers (configure at least one) -------------------------
# USDA FoodData Central: free key from https://fdc.nal.usda.gov/api-key-signup
# (DEMO_KEY works for quick local trials but is heavily rate limited.)
USDA_API_KEY=zdDLTHGnzHmWm9MDWMbHMJMCPTPfLmpkt6djjqB8
# Nutritionix: requires an approved developer account (https://www.nutritionix.com/business/api).
NUTRITIONIX_APP_ID=
NUTRITIONIX_API_KEY=
# Open Food Facts needs no key; identify your app per their API terms.
OPEN_FOOD_FACTS_ENABLED=true
OPEN_FOOD_FACTS_USER_AGENT=NutriTrack/1.0 (abhale.parth07@gmail.com)
PROVIDER_TIMEOUT_MS=8000
# Synthetic fixture provider for automated tests only. Refused when NODE_ENV=production.
ENABLE_FIXTURE_PROVIDER=false

# --- Email ---------------------------------------------------------------
# smtp    = send real email (any SMTP provider: Resend, SendGrid, Mailgun, SES, Gmail app password...)
# console = development only: write messages (with links) to the server log, NOT delivered
# none    = no email; the UI says so
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="NutriTrack <no-reply@your-domain.example>"

# In-app meal/hydration reminder job (runs every minute).
REMINDERS_ENABLED=true
